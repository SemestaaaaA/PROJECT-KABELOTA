APP_NAME=Kabelota
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@kabelota.id"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

KABELOTA_DEMO=true
KABELOTA_ADMIN_PASSWORD=
KABELOTA_DEMO_PASSWORD=
KABELOTA_ADMIN_EMAIL=admin@kabelota.id
# Alert job/backup gagal + pesan dari halaman Kontak
KABELOTA_OPS_EMAIL=
KABELOTA_QA_FORM_URL=

# Rekening transfer pasang lowongan + kontak di halaman Kontak (isi data asli dari klien)
KABELOTA_BANK_NAME=
KABELOTA_BANK_NUMBER=
KABELOTA_BANK_HOLDER=
KABELOTA_CONTACT_EMAIL=
KABELOTA_CONTACT_WHATSAPP=

# Email lewat API Brevo (MAIL_MAILER=brevo)
BREVO_API_KEY=

# Umami analytics (opsional, tanpa cookie)
UMAMI_HOST=
UMAMI_WEBSITE_ID=
UMAMI_SHARE_URL=

# Backup: disk tujuan (default storage/app/backups). Isi s3 untuk salinan di luar server.
BACKUP_DISK=backups
