# Railway > service kabelota-demo > Variables > Raw Editor. Branch: demo
APP_ENV=demo
APP_NAME=Kabelota
APP_KEY=GANTI_DENGAN_HASIL_key:generate
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_CONNECTION=sqlite
MAIL_FROM_ADDRESS=email-pengirim-yang-diverifikasi-di-brevo@gmail.com
MAIL_FROM_NAME=Kabelota
# Demo: email hanya dicatat di log, tidak benar-benar dikirim.
MAIL_MAILER=log
KABELOTA_DEMO=true
KABELOTA_ADMIN_PASSWORD=ganti-sandi-admin-minimal-12
KABELOTA_DEMO_PASSWORD=ganti-sandi-hrd-demo
KABELOTA_OPS_EMAIL=email-kamu@gmail.com
