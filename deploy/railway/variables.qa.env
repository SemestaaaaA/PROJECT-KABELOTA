# Railway > service kabelota > Variables > Raw Editor. Server QA gratis (hanya akun admin, anggota mendaftar sendiri).
APP_ENV=staging
APP_NAME=Kabelota
APP_KEY=GANTI_DENGAN_HASIL_key:generate
APP_DEBUG=false
APP_URL=https://${{RAILWAY_PUBLIC_DOMAIN}}
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stderr
LOG_LEVEL=info
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
DB_CONNECTION=sqlite
MAIL_FROM_ADDRESS=email-pengirim-yang-diverifikasi-di-brevo@gmail.com
MAIL_FROM_NAME=Kabelota
# Email asli lewat API Brevo (Railway memblokir SMTP). Isi dari Brevo > SMTP & API > API Keys.
MAIL_MAILER=brevo
BREVO_API_KEY=
KABELOTA_ADMIN_PASSWORD=ganti-sandi-admin-minimal-12
KABELOTA_OPS_EMAIL=email-kamu@gmail.com
# Link Google Form untuk tombol "Laporkan masalah"
KABELOTA_QA_FORM_URL=
