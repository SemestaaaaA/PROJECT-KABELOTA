# Railway > service kabelota-prod > Variables > Raw Editor. Branch: main (atau tag rilis).
# Setelah deploy, jalankan `php artisan kabelota:preflight` lewat `railway ssh` sampai semua OK.
APP_NAME=Kabelota
APP_ENV=production
APP_KEY=GANTI_DENGAN_HASIL_key:generate
APP_DEBUG=false
APP_URL=https://kabelota.id
APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
LOG_CHANNEL=stderr
LOG_LEVEL=warning
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database

# Untuk awal SQLite di volume /data sudah cukup. Saat data membesar, tambah service MySQL di Railway:
# DB_CONNECTION=mysql
# DB_HOST=${{MySQL.MYSQLHOST}}
# DB_PORT=${{MySQL.MYSQLPORT}}
# DB_DATABASE=${{MySQL.MYSQLDATABASE}}
# DB_USERNAME=${{MySQL.MYSQLUSER}}
# DB_PASSWORD=${{MySQL.MYSQLPASSWORD}}
DB_CONNECTION=sqlite

MAIL_MAILER=brevo
BREVO_API_KEY=
MAIL_FROM_ADDRESS=noreply@kabelota.id
MAIL_FROM_NAME=Kabelota

KABELOTA_DEMO=false
KABELOTA_ADMIN_EMAIL=admin@kabelota.id
KABELOTA_ADMIN_PASSWORD=sandi-admin-minimal-12-karakter
KABELOTA_OPS_EMAIL=
KABELOTA_BANK_NAME=
KABELOTA_BANK_NUMBER=
KABELOTA_BANK_HOLDER=
KABELOTA_CONTACT_EMAIL=
KABELOTA_CONTACT_WHATSAPP=

UMAMI_HOST=
UMAMI_WEBSITE_ID=
UMAMI_SHARE_URL=
BACKUP_DISK=backups
